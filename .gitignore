# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# playwright (e2e)
/playwright-report/
/test-results/
/playwright/.cache/
# storageState files hold live session cookies/localStorage — never commit them
/e2e/.auth/

# misc
.DS_Store
*.pem
bash.exe.stackdump

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local AI/tooling state (CLI-managed skill cache, reproducible via skills-lock.json)
.agents/*
# ...except locally-authored project skills with no upstream source (not in skills-lock.json)
!.agents/skills
.agents/skills/*
!.agents/skills/vitrina-component-design
.atl/
.mcp.json
.vscode/
auditorias/
testsprite_tests/
scripts/
docs/prompts/